[Unit]
Description=AIB 2.0 Mainnet Node
Documentation=https://docs.aib.network
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=temple
WorkingDirectory=.
ExecStart=./bin/aib-node \
  --config ./config/config.toml \
  --data-dir ./data \
  --api-port 51200 \
  --p2p-port 26656 \
  --moniker "aib-mainnet-validator"
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
TimeoutStartSec=60
LimitNOFILE=65535
LimitNPROC=4096

# environment variables
Environment="HOME=~/aib"
Environment="PORT=51200"
Environment="LOG_LEVEL=info"

# security settings
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=./data ./logs
PrivateTmp=true

# logging settings
StandardOutput=append:./logs/mainnet.log
StandardError=append:./logs/mainnet.error.log

[Install]
WantedBy=multi-user.target
